{
  "name": "donedesk",
  "productName": "DoneDesk",
  "version": "1.1.7",
  "description": "DoneDesk - daily tasks & encrypted notepad",
  "author": "Success <success@example.com>",
  "homepage": "https://github.com/gu-success/donedesk#readme",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "dist:mac": "electron-builder --mac --publish never",
    "test:e2e": "scripts/e2e.sh"
  },
  "build": {
    "appId": "com.gusuccess.donedesk",
    "productName": "DoneDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "DoneDesk",
      "artifactName": "DoneDesk-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "DoneDesk"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "maintainer": "Success",
      "executableName": "donedesk"
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "DoneDesk-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "DoneDesk-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gu-success/donedesk.git"
  },
  "bugs": {
    "url": "https://github.com/gu-success/donedesk/issues"
  }
}
